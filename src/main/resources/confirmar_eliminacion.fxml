<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="440.0" spacing="18.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-radius: 12; -fx-background-radius: 12;" xmlns="http://javafx.com/javafx/27" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <Label fx:id="iconPapelera" alignment="CENTER" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #FEE2E2; -fx-text-fill: #DC2626; -fx-background-radius: 8; -fx-font-weight: bold;" text="!" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnCerrarX" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #9CA3AF; -fx-font-size: 14px; -fx-cursor: hand;" text="X" />
            </children>
        </HBox>
        <VBox spacing="6.0">
            <children>
                <Label style="-fx-text-fill: #111827;" text="Eliminar esta candidatura?">
                    <font>
                        <Font name="System Bold" size="17.0" />
                    </font>
                </Label>
                <Label style="-fx-text-fill: #6B7280; -fx-font-size: 13px;" text="Vas a eliminar esta candidatura y sus notas. Esta accion no se puede deshacer." wrapText="true" />
            </children>
        </VBox>
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8;">
            <padding>
                <Insets bottom="12.0" left="14.0" right="14.0" top="12.0" />
            </padding>
            <children>
                <Label alignment="CENTER" prefHeight="34.0" prefWidth="34.0" style="-fx-background-color: #E5E7EB; -fx-text-fill: #4B5563; -fx-background-radius: 6; -fx-font-weight: bold;" text="ID" />
                <VBox spacing="2.0">
                    <children>
                        <Label fx:id="lblTituloEliminar" style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 13px;" text="Desarrollador Java" />
                        <Label fx:id="lblSubtituloEliminar" style="-fx-text-fill: #6B7280; -fx-font-size: 11px;" text="Indra - Candidatura #0" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <padding>
                <Insets top="4.0" />
            </padding>
            <children>
                <Button fx:id="btnCancelar" mnemonicParsing="false" prefHeight="36.0" style="-fx-background-color: #FFFFFF; -fx-text-fill: #374151; -fx-border-color: #D1D5DB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 0 16 0 16;" text="Cancelar" />
                <Button fx:id="btnConfirmarEliminar" mnemonicParsing="false" prefHeight="36.0" style="-fx-background-color: #DC2626; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 0 18 0 18;" text="Eliminar" />
            </children>
        </HBox>
    </children>
</VBox>
