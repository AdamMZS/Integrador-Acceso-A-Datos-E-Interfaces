<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1200.0" style="-fx-background-color: #FFFFFF;" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1">
<left>
    <VBox prefWidth="230.0" spacing="20.0" style="-fx-background-color: #FAFAFA; -fx-border-color: #E5E7EB; -fx-border-width: 0 1 0 0;">
        <padding>
            <Insets bottom="20.0" left="16.0" right="16.0" top="20.0" />
        </padding>
        <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@images/logo2.png" />
                        </image>
                    </ImageView>
                    <VBox spacing="1.0">
                        <children>
                            <Label style="-fx-text-fill: #111827;" text="Postula">
                                <font>
                                    <Font name="System Bold" size="15.0" />
                                </font>
                            </Label>
                            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 11px;" text="Por Alvaro y Adam" />
                        </children>
                    </VBox>
                </children>
            </HBox>
            <VBox spacing="6.0">
                <children>
                    <Button fx:id="btnNavInicio" alignment="CENTER_LEFT" graphicTextGap="10.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="36.0" style="-fx-background-color: transparent; -fx-text-fill: #4B5563; -fx-cursor: hand;" text="Inicio">
                     <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/home.png" />
                           </image>
                        </ImageView>
                     </graphic></Button>
                    <Button fx:id="btnNavCandidaturas" alignment="CENTER_LEFT" graphicTextGap="10.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="36.0" style="-fx-background-color: transparent; -fx-text-fill: #4B5563; -fx-cursor: hand;" text="Candidaturas">
                     <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/menu-burger.png" />
                           </image>
                        </ImageView>
                     </graphic></Button>
                    <Button fx:id="btnNavAnadir" alignment="CENTER_LEFT" graphicTextGap="10.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="36.0" style="-fx-background-color: #EEF2FF; -fx-text-fill: #4F46E5; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Añadir">
                     <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@images/add.png" />
                           </image>
                        </ImageView>
                     </graphic></Button>
                </children>
            </VBox>
            <Region VBox.vgrow="ALWAYS" />
            <VBox spacing="10.0" style="-fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0;">
                <padding>
                    <Insets top="14.0" />
                </padding>
                <children>
                    <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 10px; -fx-font-weight: bold;" text="ESPACIO PERSONAL" />
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <children>
                            <Label alignment="CENTER" prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: #E0E7FF; -fx-text-fill: #4F46E5; -fx-background-radius: 16; -fx-font-weight: bold;" text="U" />
                            <VBox>
                                <children>
                                    <Label style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 12px;" text="Usuario" />
                                    <Label style="-fx-text-fill: #6B7280; -fx-font-size: 11px;" text="Mi espacio de trabajo" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </children>
            </VBox>
        </children>
    </VBox>
</left>
<center>
    <VBox spacing="16.0" style="-fx-background-color: #FFFFFF;">
        <children>
            <HBox alignment="CENTER_LEFT" prefHeight="48.0" spacing="8.0" style="-fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
                <padding>
                    <Insets left="28.0" right="28.0" />
                </padding>
                <children>
                    <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" text="Mi espacio de trabajo" />
                    <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12px;" text="/" />
                    <Label fx:id="lblBreadcrumbActual" style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 12px;" text="Añadir candidatura" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" text="Tracker de Candidaturas Laborales" />
                </children>
            </HBox>
            <VBox spacing="16.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="24.0" left="36.0" right="36.0" top="4.0" />
                </padding>
                <children>
                    <VBox spacing="4.0">
                        <children>
                            <Label fx:id="lblTituloPagina" style="-fx-text-fill: #111827;" text="Añadir candidatura">
                                <font>
                                    <Font name="System Bold" size="22.0" />
                                </font>
                            </Label>
                            <Label fx:id="lblSubtituloPagina" style="-fx-text-fill: #6B7280; -fx-font-size: 13px;" text="Registra una nueva oportunidad para empezar a darle seguimiento." />
                        </children>
                    </VBox>
                    <VBox spacing="16.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-background-radius: 10;">
                        <padding>
                            <Insets bottom="22.0" left="26.0" right="26.0" top="20.0" />
                        </padding>
                        <children>
                            <HBox alignment="CENTER_LEFT">
                                <children>
                                    <Label fx:id="lblTituloTarjeta" style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 14px;" text="Datos de la candidatura" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;" text="* Campos obligatorios" />
                                </children>
                            </HBox>
                            <HBox fx:id="bannerErrorGeneral" alignment="CENTER_LEFT" managed="false" spacing="8.0" style="-fx-background-color: #FEF2F2; -fx-border-color: #FECACA; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10 14 10 14;" visible="false">
                                <children>
                                    <Label style="-fx-text-fill: #DC2626; -fx-font-weight: bold; -fx-font-size: 12px;" text="! Revisa los campos indicados" />
                                </children>
                            </HBox>
                            <HBox spacing="20.0">
                                <children>
                                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 12px;" text="Titulo *" />
                                            <TextField fx:id="txtTitulo" prefHeight="36.0" promptText="Ej. Desarrollador Java" style="-fx-background-color: #FFFFFF; -fx-border-color: #D1D5DB; -fx-border-radius: 6; -fx-background-radius: 6;" />
                                            <Label fx:id="lblErrorTitulo" managed="false" style="-fx-text-fill: #DC2626; -fx-font-size: 11px;" text="Introduce el titulo del puesto." visible="false" />
                                        </children>
                                    </VBox>
                                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 12px;" text="Empresa *" />
                                            <TextField fx:id="txtEmpresa" prefHeight="36.0" promptText="Ej. Indra" style="-fx-background-color: #FFFFFF; -fx-border-color: #D1D5DB; -fx-border-radius: 6; -fx-background-radius: 6;" />
                                            <Label fx:id="lblErrorEmpresa" managed="false" style="-fx-text-fill: #DC2626; -fx-font-size: 11px;" text="Introduce el nombre de la empresa." visible="false" />
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>
                            <HBox spacing="20.0">
                                <children>
                                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 12px;" text="Estado *" />
                                            <HBox spacing="8.0">
                                                <children>
                                                    <ToggleButton fx:id="btnEstadoPendiente" mnemonicParsing="false" prefHeight="36.0" prefWidth="95.0" selected="true" styleClass="estado-btn" text="Pendiente">
                                                        <toggleGroup>
                                                            <ToggleGroup fx:id="grupoEstado" />
                                                        </toggleGroup>
                                                    </ToggleButton>
                                                    <ToggleButton fx:id="btnEstadoEntrevista" mnemonicParsing="false" prefHeight="36.0" prefWidth="95.0" styleClass="estado-btn" text="Entrevista" toggleGroup="$grupoEstado" />
                                                    <ToggleButton fx:id="btnEstadoRechazado" mnemonicParsing="false" prefHeight="36.0" prefWidth="95.0" styleClass="estado-btn" text="Rechazado" toggleGroup="$grupoEstado" />
                                                    <ToggleButton fx:id="btnEstadoAceptado" mnemonicParsing="false" prefHeight="36.0" prefWidth="95.0" styleClass="estado-btn" text="Aceptado" toggleGroup="$grupoEstado" />
                                                </children>
                                            </HBox>
                                        </children>
                                    </VBox>
                                    <VBox prefWidth="280.0" spacing="6.0">
                                        <children>
                                            <Label style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 12px;" text="Fecha de postulacion *" />
                                            <DatePicker fx:id="dpFecha" maxWidth="1.7976931348623157E308" prefHeight="36.0" promptText="dd/MM/yyyy" style="-fx-background-color: #FFFFFF; -fx-border-color: #D1D5DB; -fx-border-radius: 6; -fx-background-radius: 6;" />
                                            <Label fx:id="lblErrorFecha" managed="false" style="-fx-text-fill: #DC2626; -fx-font-size: 11px;" text="Fecha no valida. Usa dd/MM/yyyy." visible="false" />
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>
                            <VBox spacing="6.0">
                                <children>
                                    <Label style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 12px;" text="Enlace (opcional)" />
                                    <TextField fx:id="txtEnlace" prefHeight="36.0" promptText="https://" style="-fx-background-color: #FFFFFF; -fx-border-color: #D1D5DB; -fx-border-radius: 6; -fx-background-radius: 6;" />
                                </children>
                            </VBox>
                            <VBox spacing="6.0">
                                <children>
                                    <Label style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 12px;" text="Notas (opcional)" />
                                    <TextArea fx:id="txtNotas" prefHeight="95.0" promptText="Añade detalles de la oferta o informacion que quieras recordar..." style="-fx-background-color: #FFFFFF; -fx-border-color: #D1D5DB; -fx-border-radius: 6; -fx-background-radius: 6;" wrapText="true" />
                                </children>
                            </VBox>
                            <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-border-color: #F3F4F6; -fx-border-width: 1 0 0 0; -fx-padding: 16 0 0 0;">
                                <children>
                                    <Label fx:id="lblNotaInferior" style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;" text="Puedes actualizar estos datos en cualquier momento." />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnCancelar" mnemonicParsing="false" prefHeight="36.0" style="-fx-background-color: #FFFFFF; -fx-text-fill: #374151; -fx-border-color: #D1D5DB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 0 18 0 18;" text="Cancelar" />
                                    <Button fx:id="btnGuardar" graphicTextGap="10.0" mnemonicParsing="false" prefHeight="36.0" style="-fx-background-color: #4F46E5; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 0 20 0 20;" text="Guardar">
                                 <graphic>
                                    <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@images/check-circle.png" />
                                       </image>
                                    </ImageView>
                                 </graphic></Button>
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </children>
            </VBox>
        </children>
    </VBox>
</center>
</BorderPane>
